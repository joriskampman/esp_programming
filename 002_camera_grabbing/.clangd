  #   - '-D_GNU_SOURCE'
  #   - '-D_GLIBCXX_HAVE_POSIX_SEMAPHORE'
  #   - '-D_GLIBCXX_USE_POSIX_SEMAPHORE'
  #   - '-D_POSIX_READER_WRITER_LOCKS'